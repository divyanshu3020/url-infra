# This file is a reference template only.
# docker-compose.yml loads .env.generation and .env.redirection separately.
# Copy the relevant variables into those files and keep real values out of Git.

# Shared runtime settings
NODE_ENV=production
LOG_LEVEL=info
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-secret
REDIS_TLS=false
SCYLLA_HOST=scylladb
SCYLLA_USER=replace-with-scylla-user
SCYLLA_PASSWORD=replace-with-a-secret
SCYLLA_TLS=false

# Generation service only
WORKER_ID=1

# Resolver service only
PORT=3001
